# Copy to .env.local (never commit .env.local).
# WARNING: Any VITE_* variable is bundled into the browser — visible to visitors.
# For production, call Gemini from a small backend/proxy instead of the client.

# Canonical public site URL (no trailing slash). Used for SEO canonical, OG, sitemap links.
# VITE_SITE_URL=https://www.erzurumtb.org.tr

# Set to false on IP/staging deploys to emit noindex until domain is connected.
# VITE_ALLOW_INDEXING=false

# Backend public API URL (no trailing slash). In local dev, leave unset and use Vite proxy (vite.config.ts).
# Production VPS: http://139.59.156.88 (same host as site; nginx proxies /api and /uploads).
# VITE_API_URL=http://localhost:3001
# VITE_SAME_ORIGIN_API=true

# Server deploy (.env on VPS): set TRUST_PROXY=true when API is behind nginx
# POSTGRES_PASSWORD and REDIS_PASSWORD are required (see docker-compose.server.yml)

# Recipe chat uses backend POST /api/v1/recipe-chat (set GEMINI_API_KEY on the API server).
# Do not put Gemini keys in VITE_* — they are bundled into the browser.

# Üye Girişi butonunun açacağı dış portal (tanımsızsa buton /iletisim'e yönlendirir).
# VITE_MEMBER_PORTAL_URL=https://uye.example.org.tr
