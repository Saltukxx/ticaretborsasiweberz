# After enable-https.sh — merge into /opt/etb/.env (replace example.com)
BASE_URL=https://example.com
COOKIE_SECURE=true
ALLOWED_ORIGINS=https://example.com,https://admin.example.com

# Rebuild images locally (then redeploy tars):
#   docker build -t etb-frontend:latest --build-arg VITE_API_URL=https://example.com --build-arg VITE_SAME_ORIGIN_API=true .
#   docker build -t etb-admin:latest --build-arg VITE_API_URL=https://admin.example.com --build-arg VITE_SAME_ORIGIN_API=true ./admin-panel
