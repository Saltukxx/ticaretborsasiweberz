{
  "name": "@etb/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run sync:recipe-context && tsc -p tsconfig.build.json",
    "sync:recipe-context": "tsx ../scripts/sync-kadayif-context.ts",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed:admin": "tsx src/scripts/seedSuperAdmin.ts",
    "sync:databank": "node dist/scripts/runDatabankSync.js",
    "repair:product-names": "node dist/scripts/repairProductNames.js",
    "sync:databank:dev": "tsx src/scripts/runDatabankSync.ts",
    "sync:databank:poc": "tsx src/scripts/databankPoc.ts",
    "test:databank": "tsx --test src/modules/databankSync/mapper.test.ts src/modules/databankSync/parsers/htmlTable.test.ts src/modules/databankSync/encoding.test.ts src/modules/databankSync/validate.test.ts src/modules/databankSync/mergePrices.test.ts src/modules/siteChat/siteChat.test.ts src/modules/siteChat/siteChat.cmsFetch.test.ts src/lib/geminiStream.test.ts src/modules/recipeChat/recipeChat.context.test.ts",
    "test:leadership": "tsx --test src/modules/leadership/leadershipRoleKey.test.ts",
    "test:recipe-chat": "tsx --test src/modules/recipeChat/recipeChat.schema.test.ts src/modules/recipeChat/recipeChat.context.test.ts src/lib/recipeVideoControl.test.ts src/lib/recipeChatFallback.test.ts",
    "extract:corporate-docs": "tsx src/scripts/extractCorporateDocBodies.ts",
    "seed:corporate-bodies": "tsx src/scripts/seedCorporateBodies.ts",
    "import:legacy-news": "tsx src/scripts/importLegacyNews.ts",
    "import:legacy-announcements": "tsx src/scripts/importLegacyAnnouncements.ts",
    "import:leadership-portraits": "tsx src/scripts/importLeadershipPortraits.ts",
    "import:tescil-year": "tsx src/scripts/importTescilYear.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "bcryptjs": "^2.4.1",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.40.1",
    "fastify": "^5.2.2",
    "fastify-plugin": "^5.0.1",
    "iconv-lite": "^0.7.2",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "pdfjs-dist": "^5.6.205",
    "@napi-rs/canvas": "^0.1.68",
    "pg": "^8.14.1",
    "sanitize-html": "^2.17.4",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/iconv-lite": "^0.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.1",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.12",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "^0.30.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
