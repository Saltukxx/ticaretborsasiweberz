# Runtime-only image: build dist locally (npm run build), then docker build -f Dockerfile.prebuilt .
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package*.json ./
RUN npm ci --omit=dev
COPY dist ./dist
COPY src/seed-data ./dist/seed-data
RUN mkdir -p /app/uploads && chown -R node:node /app/uploads
USER node
EXPOSE 3001
CMD ["node", "dist/server.js"]
