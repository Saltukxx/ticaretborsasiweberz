# App
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
BASE_URL=http://localhost:3001
# Set true when API is behind nginx (docker-compose.server / production)
# TRUST_PROXY=true
# Public site URL for sitemap.xml (no trailing slash). Defaults to https://www.erzurumtb.org.tr
# SITE_URL=https://www.erzurumtb.org.tr

# Database — set POSTGRES_PASSWORD in shell / .env before docker compose up
DATABASE_URL=postgres://etb:YOUR_POSTGRES_PASSWORD@localhost:5432/etb
DATABASE_POOL_MAX=10

# Redis — required in production; use password in Docker (see REDIS_PASSWORD in compose)
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@localhost:6379
REDIS_PREFIX=etb:

# JWT — generate: openssl rand -hex 32  (do not use placeholder values)
JWT_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

SESSION_COOKIE_NAME=etb_refresh
# On HTTPS production: COOKIE_SECURE=true (or omit when BASE_URL is https://)
# On plain-HTTP VPS: COOKIE_SECURE=false

# Comma-separated; add production origins when deploying
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Local media uploads directory (fallback when R2 is not configured).
# Files are served at GET /uploads/<filename>.
# In Docker this path is mounted as a named volume (etb_uploads).
# UPLOADS_DIR=/app/uploads

# PDF uploads are always saved under UPLOADS_DIR (Docker volume etb_uploads).
# Images use R2 when configured below; otherwise local disk.

# Cloudflare R2 — optional; images use R2 when all vars are set (PDFs stay on server disk)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_PUBLIC=etb-media
# R2_BUCKET_PRIVATE=etb-reports
# R2_PUBLIC_URL=https://cdn.example.com

# Kadayıf tarif sohbeti (POST /api/v1/recipe-chat). Omit to use scripted fallback only.
# Sadece backend ortaminda — ASLA VITE_GEMINI_* kullanmayin (tarayiciya sizar).
# Uretim: /opt/etb/.env icinde GEMINI_API_KEY=... (chmod 600). Anahtari Google AI Studio'da
# IP kisitlamasi ile sunucu IP'sine baglayin.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MAX_OUTPUT_TOKENS=512
# GEMINI_MAX_OUTPUT_TOKENS=512

# Set to true on deploy to run DDL migrations before listen (or run `npm run db:migrate`)
# RUN_MIGRATIONS=false

# DataBank scrape (borsa.erzurumtb.org.tr/web/data)
# DATABANK_BASE_URL=https://borsa.erzurumtb.org.tr/web/data/
# DATABANK_SYNC_ENABLED=true
# DATABANK_REQUEST_DELAY_MS=2000
# DATABANK_TESCIL_BACKFILL_DAYS=0
# DATABANK_SYNC_SECTIONS=home,tescil
# DATABANK_PRICE_SOURCE_PRIORITY=tescil,home
# DATABANK_HOURLY_SYNC=true
# DATABANK_SYNC_CRON=5 * * * *
# SYNC_ADMIN_EMAIL=sync@etb.internal
